{
  "info": {
    "name": "Nixify OTP API",
    "_postman_id": "nixify-otp-collection-v1",
    "description": "Official Postman collection for the Nixify Email OTP platform. Import this collection, set your API key in the collection variables, and start testing.\n\nDocs: /docs\nPlayground: /dashboard/playground\nError Explorer: /dashboard/errors",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey", "value": "mg_test_devkey_0000000000000000000000", "type": "string" },
    { "key": "testEmail", "value": "user@example.com", "type": "string" },
    { "key": "otpCode", "value": "", "type": "string" },
    { "key": "requestId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "OTP",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/send",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"purpose\": \"signup\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200/201', () => pm.expect([200,201]).includes(pm.response.code));", "const body = pm.response.json();", "if (body.code) { pm.collectionVariables.set('otpCode', body.code); }", "if (body.request_id) { pm.collectionVariables.set('requestId', body.request_id); }"] } }]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/verify",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"{{otpCode}}\"\n}" }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/otp/resend",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"purpose\": \"signup\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Sandbox",
      "item": [
        {
          "name": "Send OTP (Simulate Rate Limited)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Sandbox-Simulate", "value": "rate_limited" }
            ],
            "url": "{{baseUrl}}/api/v1/otp/send",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\"\n}" }
          }
        },
        {
          "name": "Verify OTP (Simulate Mismatch)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Sandbox-Simulate", "value": "mismatch" }
            ],
            "url": "{{baseUrl}}/api/v1/otp/verify",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"123456\"\n}" }
          }
        },
        {
          "name": "Verify OTP (Simulate Expired)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Sandbox-Simulate", "value": "expired" }
            ],
            "url": "{{baseUrl}}/api/v1/otp/verify",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"123456\"\n}" }
          }
        }
      ]
    }
  ]
}
