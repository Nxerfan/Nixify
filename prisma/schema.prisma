// Prisma schema for the OTP Email Verification Service with production-grade
// security layer (device fingerprinting, IP blocking, disposable-email blocklist,
// VPN/proxy policy, brute-force & account lockout, security event audit).
//
// Uses PostgreSQL (Neon for production, local PostgreSQL for development).
// The `provider` below is already `"postgresql"` — there is no SQLite path.
// IDs use `Int @default(autoincrement())`; `Bytes` (codeHash) is supported by
// PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  emailVerified    Boolean   @default(false)
  fullName         String?
  firstName        String?
  lastName         String?
  phoneNumber      String?
  profileCompleted Boolean   @default(false)
  trialStartedAt   DateTime?
  trialExpiresAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  otpCodes         OtpCode[]

  // ---- Entitlements: subscription plan ----
  // "FREE" | "PRO" | "MAX". Changed by admin or billing webhook. Takes effect
  // on the next request — no re-login or new API key required.
  plan String @default("FREE")

  // ---- Account lock (§9) ----
  lockedReason String? // "brute_force" | "admin" | null
  lockedUntil  DateTime?
  lockedAt     DateTime?

  // ---- Contacts (Phase 1) ----
  contacts           Contact[]
  broadcasts         Broadcast[]
  broadcastMutations BroadcastMutationIdempotency[]

  // ---- Transactional Templates (Phase 3) ----
  transactionalTemplates TransactionalTemplate[]

  // ---- Email Messages (Phase 4) ----
  emailMessages EmailMessage[]

  // ---- Job Queue (Phase 5) ----
  jobQueue JobQueue[]

  // ---- Automation Settings (Phase 5) ----
  automationSettings AutomationSetting[]

  // ---- Inbound Events (Phase 6) ----
  inboundEvents InboundEvent[]

  // ---- Groups (Phase 8) ----
  groups Group[]

  // ---- Contact Imports (Phase 8) ----
  contactImports ContactImport[]

  // ---- Locale preference (Phase 12 — Persian Localization) ----
  // Nullable. NULL means "no explicit preference — use signal-based resolution".
  // Constrained to ('en', 'fa') via a CHECK constraint in migration
  // 20260923000000_add_user_locale_preference (Prisma 6 has no first-class
  // CHECK DSL — the migration enforces it).
  preferredLocale String?

  // ---- Nullable-FK relations (onDelete: Cascade — explicitly deleted) ----
  otpEvents        OtpEvent[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  requestLogs      RequestLog[]
  emailThemes      EmailTheme[]

  @@index([email])
  @@index([plan])
}

// ---- Contacts (Phase 1) -----------------------------------------------
// Per-user contact directory. Each Contact belongs to exactly one User.
// Identity: (userId, normalized email). Idempotent upsert by this pair.
// Marketing consent is separate from contact source — OTP verification
// sets source="otp_verified" but does NOT change marketingStatus.
// `attributes` is JSONB for flexible custom fields (plan, country, etc.).
model Contact {
  id                     Int       @id @default(autoincrement())
  userId                 Int
  email                  String // normalized: trimmed + lowercased
  name                   String?
  attributes             Json      @default("{}")
  source                 String    @default("api") // "api" | "dashboard" | "otp_verified" | "import"
  marketingStatus        String    @default("unknown") // "unknown" | "subscribed" | "unsubscribed"
  marketingConsentSource String?
  marketingConsentAt     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events              ContactEvent[]
  inboundEvents       InboundEvent[]
  groupMemberships    ContactGroupMembership[]
  consentEvents       ContactConsentEvent[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([userId, email])
  @@unique([userId, id])
  @@index([userId, email])
  @@index([userId, marketingStatus])
}

// Contact lifecycle timeline. User-centric — NOT a copy of RequestLog.
// Only user-relevant lifecycle events belong here.
// Phase 1 events: "contact.created", "contact.updated".
// Future events (otp.verified, email.sent, group.added) added in later phases.
model ContactEvent {
  id        Int      @id @default(autoincrement())
  contactId Int
  type      String // "contact.created" | "contact.updated" | "otp.verified" | "email.sent"
  detail    Json? // event-specific metadata, e.g. {"field": "name", "old": "Alice", "new": "Bob"}
  requestId String? // optional correlation to OtpCode.requestId or EmailMessage.id
  // Phase 5: DB-enforced idempotency for dedup-able events (e.g. "otp.verified").
  // NULL for existing events (no dedupe). Unique when set — P2002 on insert means
  // the event already exists, so the caller treats it as already-recorded.
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([type, createdAt])
}

model OtpCode {
  id          Int       @id @default(autoincrement())
  requestId   String    @unique @default(uuid())
  targetEmail String
  codeHash    Bytes
  purpose     String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Environment scoping: "development" (mg_test_ key) or "production" (mg_live_ key).
  // Null = web-auth flow (not tied to an API key environment).
  // Used to enforce test/live boundary: a test key cannot verify a live OTP.
  environment String?

  // Security context captured at issue + verify time for audit + correlation.
  issuedFromIp     String?
  issuedFromDevice String?
  issuedUserAgent  String?

  @@index([targetEmail, createdAt])
  @@index([purpose, createdAt])
  @@index([environment])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ---- Security layer tables -----------------------------------------------

/// Device-fingerprint request counter. One row per (fingerprint, window).
/// Used to detect excessive OTP requests from the same device (§5).
model DeviceRequest {
  id          Int      @id @default(autoincrement())
  fingerprint String
  email       String?
  ip          String?
  purpose     String?
  createdAt   DateTime @default(now())

  @@index([fingerprint, createdAt])
  @@index([createdAt])
}

/// IP blocklist (§4). IPs are added automatically when abusive thresholds are
/// crossed, or manually via the admin dashboard. Auto-expires; admin entries
/// have null expiresAt.
model IpBlock {
  id        Int       @id @default(autoincrement())
  ip        String
  reason    String // "auto_rate_limit" | "auto_brute_force" | "admin"
  expiresAt DateTime? // null = permanent (admin-set)
  createdAt DateTime  @default(now())
  createdBy String? // admin id, if admin-set

  @@index([ip])
  @@index([expiresAt])
}

/// Disposable-email domain blocklist + allowlist (§7). Seeded with known
/// disposable providers; admin can add/remove.
model DisposableDomain {
  id        Int      @id @default(autoincrement())
  domain    String   @unique
  listType  String // "block" | "allow"
  source    String // "seed" | "admin"
  createdAt DateTime @default(now())

  @@index([listType])
}

/// Security event audit log (§deterministic, append-only). Every security
/// decision is recorded here for the admin dashboard + forensics.
model SecurityEvent {
  id          Int      @id @default(autoincrement())
  type        String // e.g. "ip_blocked", "device_exceeded", "disposable_rejected", "vpn_blocked", "brute_force_lockout", "account_locked"
  ip          String?
  email       String?
  fingerprint String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([ip, createdAt])
  @@index([email, createdAt])
}

/// Admin users for the security dashboard (§9 manual unlock, blocklist mgmt).
/// Seeded on first run with ADMIN_EMAIL/ADMIN_PASSWORD env vars.
model AdminUser {
  id                 Int         @id @default(autoincrement())
  email              String      @unique
  passwordHash       String
  tokenVersion       Int         @default(0)
  createdAt          DateTime    @default(now())
  // Phase 10: broadcasts reviewed by this admin. Single-column nullable FK on
  // Broadcast.reviewedByAdminId with ON DELETE SET NULL — admin row deletion
  // preserves broadcast audit history.
  broadcastsReviewed Broadcast[]
}

/// OTP event log — the analytics data source. Every discrete OTP lifecycle
/// event is recorded here (requested, sent, verified, failed, expired, resent).
/// Append-only; never updated. This powers the Activity tab + all charts.
///
/// `userId` scopes ownership for per-user analytics scoping: PRO/MAX users see
/// only their own events; admins see all. When null (legacy events, or events
/// triggered outside an API-key context), the event is visible only to admins.
model OtpEvent {
  id         Int      @id @default(autoincrement())
  userId     Int? // owner (resolved at log time from API key or session); null = admin-only
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId  String // links to OtpCode.requestId
  email      String // stored for filtering; masked at the API layer
  eventType  String // requested | sent | verified | failed | expired | resent
  status     String // success | error
  purpose    String // signup | login | reset
  ip         String?
  detail     String? // error message / extra context
  durationMs Int? // for verified events: time from issue to verify
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([requestId])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ---- Developer Experience (DX) layer --------------------------------------

/// API keys for programmatic access to the v1 REST API. Stored as a hash (never
/// plaintext). The full key is shown ONCE at creation. Keys carry an
/// environment (dev/prod), scopes (read_only/full), and optional expiry.
///
/// `userId` scopes ownership: a user only sees/manages their own keys.
/// When null (legacy/admin-created), the key is treated as a system key
/// (admin-only visibility). `createdBy` (email) is kept for backwards compat.
model ApiKey {
  id          Int       @id @default(autoincrement())
  userId      Int? // owner; null = system/admin-managed key
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash     String    @unique // SHA-256 of the full key
  prefix      String // "mg_live_" / "mg_test_" + 8 chars (for display)
  name        String // human label
  environment String // "development" | "production"
  scopes      String // "full" | "read_only" | "otp:send,otp:verify"
  lastUsedAt  DateTime?
  lastUsedIp  String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String? // admin email (legacy; userId is the canonical owner)

  @@index([prefix])
  @@index([environment])
  @@index([userId])
}

/// Webhook endpoints — developers register URLs to receive event deliveries.
/// `userId` scopes ownership: a user only sees/manages their own endpoints.
/// When null (legacy data), the endpoint is treated as a system endpoint.
model WebhookEndpoint {
  id        Int      @id @default(autoincrement())
  userId    Int? // owner; null = system/admin-managed endpoint
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  secret    String // HMAC signing secret (shown once at creation)
  events    String // comma-separated event types: "otp.sent,otp.verified"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?

  deliveries WebhookDelivery[]
  queueJobs  WebhookQueue[]

  @@index([isActive])
  @@index([userId])
}

/// Webhook delivery records — each attempted delivery gets a row for the
/// testing/replay/retry UI.
model WebhookDelivery {
  id           Int             @id @default(autoincrement())
  // Phase 7: public UUID identifier (exposed in dashboard + Nixify-Delivery-Id header).
  deliveryId   String          @unique @default(uuid())
  endpointId   Int
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId      String // the webhook envelope type, e.g. "nixify.event.received" or "otp.verified"
  requestId    String // correlation to the original request/event
  payload      String // JSON string
  signature    String // HMAC-SHA256 of the payload
  status       String // "pending" | "delivered" | "failed"
  responseCode Int?
  attempts     Int             @default(0)
  lastError    String?
  // Phase 7: DB-enforced dispatch dedupe. For inbound events:
  // "inbound_event:<eventId>:endpoint:<endpointId>". Null for non-dedupable deliveries.
  dedupeKey    String?
  // Phase 7: correlation to the original delivery for manual replays.
  replayOfId   Int?
  createdAt    DateTime        @default(now())
  deliveredAt  DateTime?

  @@index([endpointId, createdAt])
  @@index([status])
  @@index([dedupeKey])
}

/// Request log — every v1 API call gets a row for the live request-log viewer.
model RequestLog {
  id          Int      @id @default(autoincrement())
  requestId   String   @unique
  apiKeyId    Int?
  // Phase 7: explicit tenant ownership. Null for system/legacy requests.
  // NEVER appears in a normal user's dashboard logs when null.
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment String?
  method      String
  path        String
  status      Int
  durationMs  Int
  ip          String?
  userAgent   String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ---- Email Customization System -------------------------------------------

/// Brand Kit — reusable branding assets preserved across template switches.
/// One per user account. Each user has exactly one brand kit.
model BrandKit {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  appName        String   @default("MailGuard")
  logoUrl        String?
  primaryColor   String   @default("#059669")
  secondaryColor String   @default("#0f172a")
  accentColor    String   @default("#f59e0b")
  website        String?
  supportEmail   String?
  defaultFont    String   @default("Inter")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/// Email Theme — a user's customized OTP email template. Stores the full config
/// (components, branding overrides, typography, etc.) as JSON. `templateId`
/// references one of the 20 built-in templates.
///
/// `userId` scopes ownership: a user can only edit/delete their own themes.
/// When null (legacy data), the theme is treated as a system/default theme
/// (read-only for non-admins).
model EmailTheme {
  id         Int      @id @default(autoincrement())
  userId     Int? // owner; null = system/default theme (admin-managed)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  templateId String // "minimal", "modern", "discord", etc.
  isPro      Boolean  @default(false)
  isActive   Boolean  @default(false) // only one active per purpose
  purpose    String   @default("signup") // signup|login|reset|verification|2fa|all
  config     String // JSON: { components, header, otpCard, background, footer, typography, language }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([purpose, isActive])
  @@index([templateId])
  @@index([userId])
}

// ---- Entitlements: monthly usage tracking (atomic consume) ---------------
// One row per (userId, featureKey, periodStart). Incremented atomically via
// updateMany with a WHERE clause that checks remaining > 0 (same pattern as
// the OTP single-use consume in otp/verifier.ts).
model UsageTracking {
  id          Int      @id @default(autoincrement())
  userId      Int
  featureKey  String // e.g. "api_messages", "otp_emails"
  count       Int      @default(0)
  periodStart DateTime // start of billing month
  periodEnd   DateTime // end of billing month
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, featureKey, periodStart])
  @@index([userId, featureKey])
  @@index([periodEnd])
}

// ---- Webhook Queue (persistent retry scheduler) ---------------------------
// Replaces setTimeout-based retries. The cron processor at
// /api/webhooks/process-queue fetches rows where nextRetryAt <= NOW(),
// attempts delivery, and either marks done or schedules the next retry.
// This survives Vercel serverless instance recycling.
model WebhookQueue {
  id          Int             @id @default(autoincrement())
  endpointId  Int
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveryId  Int // links to WebhookDelivery for audit
  payload     String // JSON string
  signature   String // HMAC-SHA256
  eventType   String // "nixify.event.received", "otp.sent", etc.
  attempts    Int             @default(0)
  maxRetries  Int             @default(3)
  nextRetryAt DateTime // when the cron should pick this up
  status      String          @default("pending") // "pending" | "processing" | "done" | "failed"
  // Phase 7: atomic claiming + stale-lock recovery.
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  completedAt DateTime?
  failedAt    DateTime?

  @@index([status, nextRetryAt])
  @@index([nextRetryAt])
}

// ---- Transactional Templates (Phase 3) ------------------------------------
// Reusable transactional email templates that future messaging features will
// use. SEPARATE from the OTP EmailTheme system — these are generic templates,
// not OTP-specific. OTP behavior and EmailTheme are unchanged by this phase.
//
// Parent template holds mutable metadata (name, slug, description).
// `currentVersion` points at the latest immutable content snapshot.
// Slug is tenant-unique: (userId, slug). Same slug may exist for two users.
model TransactionalTemplate {
  id             Int      @id @default(autoincrement())
  userId         Int
  name           String
  slug           String
  description    String?
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions           TransactionalTemplateVersion[]
  emailMessages      EmailMessage[]
  automationSettings AutomationSetting[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
}

// Immutable content snapshot of a template. NEVER UPDATED after creation.
// Each content edit inserts a new version row with version = parent.currentVersion
// (atomically incremented inside a transaction). Historical versions cannot be
// edited or deleted individually — only the parent template can be deleted,
// which cascades all versions.
//
// `variables` is a deterministic, de-duplicated, sorted list of flat variable
// names (e.g. ["name", "order_id"]) extracted from subject+html+text.
model TransactionalTemplateVersion {
  id         Int      @id @default(autoincrement())
  templateId Int
  version    Int
  subject    String
  html       String
  text       String?
  variables  Json
  createdAt  DateTime @default(now())

  template TransactionalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

// ---- Email Messages (Phase 4) ---------------------------------------------
// Persisted record of every transactional email send attempt. Stores audit
// metadata (recipient, rendered subject, status, provider ids) but NOT the
// full rendered HTML body or variable values — those may contain sensitive
// application data the caller does not want persisted indefinitely.
//
// Idempotency: (userId, idempotencyKeyHash) is unique. The idempotency key is
// SHA-256 hashed before storage (never plaintext). A separate requestFingerprint
// (SHA-256 of the canonicalized request body) lets us detect same-key-different-body
// conflicts and return 409.
//
// Status lifecycle: pending -> sent | failed | rejected.
//   - pending: claim created, delivery in progress
//   - sent: provider accepted and returned a message id
//   - failed: provider call errored (safe error classification persisted)
//   - rejected: request claimed but denied before delivery (e.g. quota exhaustion)
model EmailMessage {
  id                 Int       @id @default(autoincrement())
  messageId          String    @unique @default(uuid())
  userId             Int
  templateId         Int?
  templateVersion    Int?
  toEmail            String
  subject            String
  status             String // "pending" | "sent" | "failed" | "rejected"
  provider           String?
  providerMessageId  String?
  source             String // "api_v1" | "dashboard_test"
  environment        String?
  requestId          String?
  idempotencyKeyHash String?
  requestFingerprint String?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  sentAt             DateTime?
  failedAt           DateTime?

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        TransactionalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Phase 11 audit (BLOCKER #4): back-relation for the composite FK from
  // EmailDelivery(emailMessageOwnerUserId, emailMessageId). The composite
  // unique constraint below is required by PostgreSQL as the FK target.
  emailDeliveries EmailDelivery[]        @relation("EmailDeliveryEmailMessage")

  @@unique([userId, idempotencyKeyHash])
  // Phase 11 audit (BLOCKER #4): composite unique on (userId, messageId)
  // — required as the target of the EmailDelivery composite FK. messageId
  // is already globally @unique; this composite is a strict superset.
  @@unique([userId, messageId])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([toEmail, createdAt])
}

// ---- Job Queue (Phase 5) ---------------------------------------------------
// Minimal durable database-backed queue for asynchronous post-OTP work.
// One orchestration job per OTP verification event (type="otp_verified")
// executes: Contact upsert -> ContactEvent(otp.verified) -> automation send.
//
// Dedupe: (userId, type, dedupeKey) unique constraint. For otp_verified jobs,
// dedupeKey = "otp_verified:<otpCodeId>" so the same OTP cannot enqueue twice.
//
// Atomic claim: processor uses UPDATE ... WHERE status='pending' AND
// availableAt <= NOW() SET status='processing', lockedAt=NOW(), lockedBy=<id>
// via updateMany (atomic in PostgreSQL). Stale locks recovered by timeout.
model JobQueue {
  id          Int       @id @default(autoincrement())
  jobId       String    @unique @default(uuid())
  userId      Int
  type        String
  status      String // pending | processing | completed | failed
  payload     Json
  dedupeKey   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  failedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([status, availableAt])
  @@index([userId, createdAt])
}

// ---- Automation Settings (Phase 5) -----------------------------------------
// Tenant-owned configuration for built-in automations. Phase 5 has exactly one
// automation type: "otp_verified_welcome" — sends a welcome email after OTP
// verification. No generic workflow builder in this phase.
model AutomationSetting {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       String // "otp_verified_welcome"
  enabled    Boolean  @default(false)
  templateId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  template TransactionalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([userId, type])
}

// ---- Inbound Events (Phase 6) ---------------------------------------------
// Tenant-owned durable application events ingested via POST /api/v1/events.
// These are DEVELOPER-SUPPLIED application/lifecycle events (e.g.
// "order.completed", "user.signup") — NOT Nixify-internal events like
// "otp.verified" (those go in ContactEvent). InboundEvent and ContactEvent
// serve different purposes.
//
// Idempotency: (userId, idempotencyKeyHash) unique constraint. The
// Idempotency-Key header is SHA-256 hashed before storage (never plaintext).
// A separate requestFingerprint (SHA-256 of canonicalized request body) lets
// us detect same-key-different-body conflicts and return 409.
//
// contactId is set when an existing Contact matches (userId, normalizedEmail).
// Phase 6 does NOT auto-create Contacts. If no Contact exists, contactId=null.
model InboundEvent {
  id                 Int      @id @default(autoincrement())
  eventId            String   @unique @default(uuid())
  userId             Int
  contactId          Int?
  type               String
  email              String
  environment        String
  data               Json
  source             String   @default("api_v1")
  requestId          String?
  idempotencyKeyHash String
  requestFingerprint String
  createdAt          DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKeyHash])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, email, createdAt])
  @@index([userId, environment, createdAt])
}

// ---- Groups (Phase 8) ------------------------------------------------------
// Tenant-owned static groups for organizing contacts. Two tenants may use
// the same group name — uniqueness is per-tenant via @@unique([userId, normalizedName]).
model Group {
  id             Int      @id @default(autoincrement())
  groupId        String   @unique @default(uuid())
  userId         Int
  name           String
  normalizedName String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships    ContactGroupMembership[]
  contactImports ContactImport[]

  @@unique([userId, normalizedName])
  @@unique([userId, id])
  @@index([userId, updatedAt])
}

// ---- Contact Group Membership (Phase 8) -----------------------------------
// Explicit membership records linking Contacts to Groups. Unique per
// (groupId, contactId) — adding the same contact twice is idempotent.
// The composite foreign key (userId, groupId) + (userId, contactId) enforces
// tenant safety at the DB level: it's structurally impossible to create a
// membership linking Tenant A's group to Tenant B's contact.
model ContactGroupMembership {
  id        Int      @id @default(autoincrement())
  userId    Int
  groupId   Int
  contactId Int
  source    String   @default("manual") // "manual" | "import"
  createdAt DateTime @default(now())

  group   Group   @relation(fields: [userId, groupId], references: [userId, id], onDelete: Cascade)
  contact Contact @relation(fields: [userId, contactId], references: [userId, id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([userId, groupId])
  @@index([userId, contactId])
}

// ---- Contact Import (Phase 8) ---------------------------------------------
// Staged, durable contact import. Upload/parse creates rows in preview_ready
// status. Confirm transitions to queued. The processor claims and processes
// rows in bounded batches. State machine:
//   parsing → preview_ready → queued → processing → completed | failed
//   preview_ready → cancelled (user discards)
model ContactImport {
  id               Int       @id @default(autoincrement())
  importId         String    @unique @default(uuid())
  userId           Int
  originalFilename String?
  format           String // "txt" | "json" | "xlsx"
  status           String    @default("parsing") // parsing|preview_ready|queued|processing|completed|failed|cancelled
  targetGroupId    Int?
  totalRows        Int       @default(0)
  validRows        Int       @default(0)
  invalidRows      Int       @default(0)
  duplicateRows    Int       @default(0)
  existingRows     Int       @default(0)
  importedRows     Int       @default(0)
  failedRows       Int       @default(0)
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  lockedAt         DateTime?
  lockedBy         String?
  lastError        String?

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group?             @relation(fields: [userId, targetGroupId], references: [userId, id], onDelete: SetNull)
  rows  ContactImportRow[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ---- Contact Import Row (Phase 8) -----------------------------------------
// Staged rows from the parsed file. Each row has a status that transitions
// through the import lifecycle. The processor claims pending rows in
// bounded batches and transitions them to terminal states.
model ContactImportRow {
  id            Int       @id @default(autoincrement())
  importId      Int
  userId        Int
  rowNumber     Int
  email         String
  name          String?
  attributes    Json?
  status        String    @default("staged") // staged|processing|imported|existing|invalid|failed|duplicate_file
  // Preview classification (set at staging time, separate from execution state)
  previewStatus String? // new|existing|invalid|duplicate_file
  errorCode     String?
  // Phase 8 fix: row-level atomic claiming
  lockedAt      DateTime?
  lockedBy      String?

  import ContactImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, rowNumber])
  @@index([importId, status])
  @@index([userId, email])
}

// ---- Consent History (Phase 9) ---------------------------------------------
// Immutable, tenant-owned audit trail of every marketing-consent transition
// for a Contact. One row per ACTUAL state transition. Never updated — only
// appended. Same-state repeated requests do NOT create fake transition rows
// (no-op semantics — see service).
//
// Phase 9 canonical marketing states (preserved from Phase 1 — no destructive
// rewrite): "unknown" | "subscribed" | "unsubscribed".
//
// `source` is one of: "dashboard" | "api" | "unsubscribe" | "import" | "system".
// Phase 9 only writes "dashboard", "api", "unsubscribe", and "system".
// "import" is reserved for future Phase 11 use (import-time explicit consent
// capture) — Phase 9 imports MUST NOT create consent events.
//
// IDEMPOTENCY NAMESPACE: the (userId, operation, idempotencyKeyHash) tuple
// uniquely identifies a retryable operation. `operation` is the canonical
// action name ("subscribe" | "unsubscribe") and `idempotencyKeyHash` is the
// SHA-256 of a tenant-bound domain separator + the caller-supplied key.
// This prevents the same caller key from replaying across different operations
// or different contacts. A separate `requestFingerprint` (SHA-256 of the
// canonicalized mutable request payload) detects same-key-different-body
// conflicts -> 409 idempotency_conflict at the service boundary.
// NULL idempotencyKeyHash is allowed (PostgreSQL treats each NULL as distinct)
// for non-idempotent audit rows.
//
// STRUCTURAL TENANT ISOLATION: `contact` relation uses composite FK
// (userId, contactId) -> Contact(userId, id). The database itself rejects a
// ConsentEvent row whose userId disagrees with its Contact userId —
// application-level filters are defense-in-depth, not the primary enforcement.
//
// DELETION SEMANTICS: ContactConsentEvent cascades on Contact deletion. This
// is INTENTIONAL — when a Contact is deleted at the data subject request
// (GDPR right-to-erasure), their consent history is erased with them. We do
// not retain consent audit rows for non-existent contacts. Documented in tests.
model ContactConsentEvent {
  id                 Int      @id @default(autoincrement())
  eventId            String   @unique @default(uuid())
  userId             Int
  contactId          Int
  operation          String // "subscribe" | "unsubscribe"
  previousStatus     String // "unknown" | "subscribed" | "unsubscribed"
  newStatus          String // "unknown" | "subscribed" | "unsubscribed"
  source             String // "dashboard" | "api" | "unsubscribe" | "import" | "system"
  reason             String?
  idempotencyKeyHash String?
  requestFingerprint String?
  createdAt          DateTime @default(now())

  contact Contact @relation(fields: [userId, contactId], references: [userId, id], onDelete: Cascade)

  @@unique([userId, operation, idempotencyKeyHash])
  @@index([userId, contactId, createdAt])
  @@index([userId, operation, idempotencyKeyHash])
  @@index([contactId, createdAt])
}

// ---- Suppression (Phase 9) -------------------------------------------------
// Current-state, tenant-scoped marketing suppression. At most one row per
// (userId, normalized email). Repeated suppressions upsert the existing row.
//
// `reason` is one of: "unsubscribe" | "manual" (Phase 9). Reserved for Phase 11:
// "hard_bounce" | "complaint" — Phase 9 does NOT implement provider
// bounce/complaint ingestion. The reserved values are documented here so the
// schema is forward-compatible, but Phase 9 only writes "unsubscribe" and
// "manual".
//
// `source` is one of: "dashboard" | "api" | "unsubscribe" | "system".
//
// `active=true` means the email is currently suppressed. `liftedAt` records
// when suppression was lifted (set back to null if re-suppressed). The full
// transition history is preserved in the immutable SuppressionEvent table.
model SuppressionEntry {
  id            Int       @id @default(autoincrement())
  suppressionId String    @unique @default(uuid())
  userId        Int
  email         String // normalized: trimmed + lowercased
  reason        String // "unsubscribe" | "manual" (Phase 9); future: "hard_bounce" | "complaint"
  source        String // "dashboard" | "api" | "unsubscribe" | "system"
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  liftedAt      DateTime?

  events SuppressionEvent[]

  @@unique([userId, email])
  @@unique([userId, id])
  @@index([userId, email])
  @@index([userId, active])
  @@index([userId, reason])
}

// ---- Suppression History (Phase 9) -----------------------------------------
// Immutable audit of every suppression transition. An unsubscribe must remain
// auditable even after a later explicit resubscribe (lift).
//
// DELETION POLICY: SuppressionEntry rows are durable current-state records.
// They are lifted/deactivated (active=false, liftedAt=now), NOT physically
// deleted. The `onDelete: Restrict` on the composite FK below enforces this at
// the DB level — attempting to DELETE a SuppressionEntry that still has
// SuppressionEvent history is rejected by the database. This matches the
// actual Phase 9 API surface, which only lifts suppressions, never deletes
// them. Audit history therefore always remains attached to its parent entry.
//
// `action` is one of: "suppressed" | "lifted".
//
// IDEMPOTENCY NAMESPACE: (userId, operation, idempotencyKeyHash). `operation`
// is "suppress" | "unsuppress". Same cross-operation / cross-target protection
// as ContactConsentEvent.
//
// STRUCTURAL TENANT ISOLATION: `entry` relation uses composite FK
// (userId, suppressionId) -> SuppressionEntry(userId, id). Database itself
// rejects cross-tenant event->entry references.
model SuppressionEvent {
  id                 Int      @id @default(autoincrement())
  eventId            String   @unique @default(uuid())
  userId             Int
  suppressionId      Int?
  email              String // normalized
  operation          String // "suppress" | "unsuppress"
  action             String // "suppressed" | "lifted" (denormalized for read convenience)
  reason             String
  source             String // "dashboard" | "api" | "unsubscribe" | "system"
  idempotencyKeyHash String?
  requestFingerprint String?
  createdAt          DateTime @default(now())

  entry SuppressionEntry? @relation(fields: [userId, suppressionId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, operation, idempotencyKeyHash])
  @@index([userId, email, createdAt])
  @@index([userId, operation, idempotencyKeyHash])
  @@index([suppressionId, createdAt])
}

// ---- Consent Mutation Idempotency (Phase 9) --------------------------------
// Durable idempotency outcome store for consent/suppression mutations.
// Decoupled from transition-event tables so that a NO-OP request (e.g.
// subscribing an already-subscribed contact) can be durably replayed without
// creating a fake transition event.
//
// A no-op request with an idempotency key stores resultStatus="no_op" here.
// A retry with the same key (even after the contact's state has changed)
// replays the original no_op outcome — it does NOT re-evaluate and potentially
// apply a transition that the original request did not apply.
//
// operation is the canonical action name ("subscribe" | "unsubscribe" |
// "suppress" | "unsuppress"). The unique constraint on
// (userId, operation, idempotencyKeyHash) is the idempotency namespace —
// the same key reused for a different operation does NOT replay.
//
// targetType + targetKey encode the mutation target:
//   - "contact" -> targetKey = String(contactId)
//   - "email"   -> targetKey = normalizedEmail
// Verified before replay to prevent cross-target key reuse.
//
// requestFingerprint is the SHA-256 of the canonicalized mutable payload.
// A retry with the same key but a different fingerprint throws
// IdempotencyConflictError (409).
model ConsentMutationIdempotency {
  id                  Int      @id @default(autoincrement())
  userId              Int
  operation           String // "subscribe" | "unsubscribe" | "suppress" | "unsuppress"
  targetType          String // "contact" | "email"
  targetKey           String // String(contactId) or normalizedEmail
  idempotencyKeyHash  String
  requestFingerprint  String?
  resultStatus        String // "applied" | "no_op" | "not_suppressed"
  resultEventId       String? // public UUID of the transition event (null for no_op)
  resultSuppressionId String? // public UUID of the suppression entry (for suppress ops)
  createdAt           DateTime @default(now())

  @@unique([userId, operation, idempotencyKeyHash])
  @@index([userId, operation, idempotencyKeyHash])
  @@index([userId, targetType, targetKey, createdAt])
}

// ---- Broadcast (Phase 10) --------------------------------------------------
// Tenant-owned marketing broadcast (newsletter/campaign). Content is frozen
// at launch; audience membership is snapshotted into BroadcastRecipient rows.
//
// State machine:
//   draft → review_pending → queued → sending → completed
//                              |          |          → paused_quota → sending
//                              |          → cancelled
//                              → rejected
//   draft → cancelled
//   draft → queued (at/below review threshold)
//
// REVIEW THRESHOLD: if snapshot recipient count > BROADCAST_REVIEW_THRESHOLD
// (default 1000), the broadcast enters review_pending and must be approved by
// an AdminUser before it can be queued. At or below the threshold, the
// broadcast goes directly to queued/scheduled.
//
// `reviewedByAdminId` references AdminUser (NOT User). An admin is never a
// tenant. Admin approval does not mutate campaign content/audience. The FK is
// a single-column nullable FK with ON DELETE SET NULL — admin row deletion
// preserves the broadcast's audit history (only the reviewer link is cleared).
model Broadcast {
  id                Int       @id @default(autoincrement())
  broadcastId       String    @unique @default(uuid())
  userId            Int
  name              String
  subject           String
  htmlContent       String
  textContent       String?
  audienceType      String // "all_contacts" | "group"
  targetGroupId     Int?
  status            String    @default("draft") // draft|review_pending|queued|sending|paused_quota|completed|cancelled|rejected|failed
  reviewStatus      String    @default("not_required") // not_required|pending|approved|rejected
  scheduledAt       DateTime?
  launchedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId Int?
  reviewReason      String?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Single-column nullable FK → AdminUser.id. ON DELETE SET NULL: deleting an
  // admin preserves the broadcast's audit history (reviewedAt remains).
  reviewedByAdmin AdminUser?           @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  recipients      BroadcastRecipient[]

  @@unique([userId, id])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([reviewStatus, status])
}

// ---- Broadcast Recipient (Phase 10) ----------------------------------------
// Per-recipient send record. One row per (broadcastId, contactId). Created at
// launch time via INSERT...SELECT (DB-side snapshot — no application memory
// materialization for large audiences).
//
// STRUCTURAL TENANT ISOLATION: composite FK
//   (userId, broadcastId) → Broadcast(userId, id)
// The DB itself rejects cross-tenant recipient references to the parent broadcast.
// The contactId FK is single-column (ON DELETE SET NULL) — see "CONTACT DELETION"
// below for the rationale. Tenant agreement on contactId is enforced at the
// application layer by reading both rows through the recipient's userId (which
// is NOT NULL and structurally tied to the parent broadcast).
//
// COUNTS ARE DERIVED from these rows (total/pending/processing/dispatching/
// sent/skipped/failed). No retry-sensitive increment counters as source of truth.
//
// RECIPIENT STATE MACHINE (with durable exclusive dispatch):
//   pending → processing → dispatching → sent | skipped | failed
//
//   - pending:      queued for any worker to claim.
//   - processing:   claimed by a worker via CAS (lockedBy=workerId). NO external
//                   I/O has occurred yet. Safe to stale-recover → pending.
//   - dispatching:  durable exclusive dispatch state established via
//                   CAS (processing → dispatching WHERE lockedBy=workerId).
//                   ONLY this worker may call provider.send(). NEVER
//                   auto-requeued — stale dispatching rows become terminal
//                   `failed` with errorCode=provider_outcome_unknown after
//                   a safe timeout (recoverAbandonedDispatches).
//   - sent/skipped/failed: terminal. Terminal CAS verifies lockedBy=workerId.
//
// CONTACT DELETION: `contactId` is nullable + single-column FK with
// ON DELETE SET NULL. Deleting a contact preserves the recipient row's audit
// history (sentAt, errorCode remain intact) by nullifying only contactId.
// The `userId` column remains NOT NULL — single-column SET NULL is safe because
// only `contactId` is nullified. At processRecipient time, a null contactId is
// skipped with skipReason=contact_not_found.
// We use a single-column FK (rather than the composite (userId, contactId) FK)
// because PostgreSQL's composite `ON DELETE SET NULL` would attempt to null ALL
// FK columns including the NOT NULL `userId`, which would fail. Single-column
// SET NULL on `contactId` alone is the safe form. See the Phase 9 lesson in
// agent-lessons.md about composite SET NULL with NOT NULL tenant columns.
model BroadcastRecipient {
  id                 Int       @id @default(autoincrement())
  userId             Int
  broadcastId        Int
  contactOwnerUserId Int?
  contactId          Int?
  status             String    @default("pending") // pending|processing|dispatching|sent|skipped|failed
  skipReason         String? // not_subscribed|suppressed|contact_not_found|broadcast_cancelled|quota_exhausted
  lockedAt           DateTime?
  lockedBy           String?
  providerMessageId  String?
  attemptedAt        DateTime?
  sentAt             DateTime?
  failedAt           DateTime?
  errorCode          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  broadcast       Broadcast       @relation(fields: [userId, broadcastId], references: [userId, id], onDelete: Cascade)
  contact         Contact?        @relation(fields: [contactOwnerUserId, contactId], references: [userId, id], onDelete: SetNull)
  // Phase 11 audit (BLOCKER #4): back-relation for the composite FK from
  // EmailDelivery(broadcastRecipientOwnerUserId, broadcastRecipientId).
  emailDeliveries EmailDelivery[] @relation("EmailDeliveryBroadcastRecipient")

  @@unique([broadcastId, contactId])
  @@unique([userId, id])
  @@index([broadcastId, status])
  @@index([userId, contactId])
  @@index([broadcastId, lockedAt])
}

// ---- Broadcast Mutation Idempotency (Phase 10) -----------------------------
// Durable idempotency outcome store for stateful broadcast mutations
// (launch, cancel). Decoupled from Broadcast row state so a no-op request
// (e.g. cancelling an already-cancelled broadcast) can be durably replayed
// without re-evaluating against changed state.
//
// Identity: (userId, operation, idempotencyKeyHash) — binds the key to both
// the tenant and the operation. Same key + different operation → not a replay.
//
// Conflict detection: `requestFingerprint` (SHA-256 of canonicalized body)
// detects same-key-different-payload conflicts → 409 idempotency_conflict.
//
// Target verification: `targetBroadcastId` is verified before replay to
// prevent cross-target key reuse.
model BroadcastMutationIdempotency {
  id                 Int      @id @default(autoincrement())
  userId             Int
  operation          String // "launch" | "cancel"
  targetBroadcastId  String // public broadcastId UUID
  idempotencyKeyHash String
  requestFingerprint String?
  resultStatus       String // "applied" | "no_op" | "idempotent_replay"
  resultData         Json?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, idempotencyKeyHash])
  @@index([userId, operation, idempotencyKeyHash])
  @@index([userId, targetBroadcastId])
}

// ---- Email Delivery (Phase 11) --------------------------------------------
model EmailDelivery {
  id                            Int                  @id @default(autoincrement())
  deliveryId                    String               @unique @default(uuid())
  userId                        Int
  sourceType                    String
  sourceId                      String?
  emailMessageId                String?
  // Phase 11 audit (BLOCKER #4): nullable owner column for the composite FK
  // to EmailMessage(userId, messageId). The NOT NULL `userId` is the immutable
  // tenant owner; the nullable `emailMessageOwnerUserId` is the FK column
  // that gets safely nulled by ON DELETE SET NULL when the parent is deleted.
  emailMessageOwnerUserId       Int?
  broadcastRecipientId          Int?
  broadcastRecipientOwnerUserId Int?
  provider                      String
  providerMessageId             String?
  currentStatus                 String               @default("queued")
  lastProviderEventAt           DateTime?
  acceptedAt                    DateTime?
  deliveredAt                   DateTime?
  bouncedAt                     DateTime?
  complainedAt                  DateTime?
  rejectedAt                    DateTime?
  failedAt                      DateTime?
  lastErrorCode                 String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  events                        EmailDeliveryEvent[]
  // Phase 11 audit: structural source-correlation FKs. Both owner columns are
  // nullable so ON DELETE SET NULL can null the FK without touching the NOT
  // NULL `userId`. Phase 10 lesson: never trade away DB-enforced tenant
  // agreement for delete semantics — redesign the nullable reference structure.
  emailMessage                  EmailMessage?        @relation("EmailDeliveryEmailMessage", fields: [emailMessageOwnerUserId, emailMessageId], references: [userId, messageId], onDelete: SetNull)
  broadcastRecipient            BroadcastRecipient?  @relation("EmailDeliveryBroadcastRecipient", fields: [broadcastRecipientOwnerUserId, broadcastRecipientId], references: [userId, id], onDelete: SetNull)

  @@unique([userId, id])
  @@unique([provider, providerMessageId])
  @@index([userId, createdAt])
  @@index([userId, currentStatus])
  @@index([userId, sourceType, createdAt])
  @@index([userId, broadcastRecipientId])
  @@index([userId, emailMessageId])
}

model EmailDeliveryEvent {
  id              Int           @id @default(autoincrement())
  eventId         String        @unique @default(uuid())
  userId          Int
  deliveryId      Int
  provider        String
  // Phase 11 audit (BLOCKER #5): providerEventId is NOT NULL. Deduplication
  // requires every event to have a provider-assigned identifier.
  providerEventId String
  type            String
  occurredAt      DateTime
  safeMetadata    Json?
  createdAt       DateTime      @default(now())
  delivery        EmailDelivery @relation(fields: [userId, deliveryId], references: [userId, id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([userId, deliveryId, occurredAt])
  @@index([userId, type, createdAt])
}
