# Nixify — Environment Variables
# Copy this file to .env and fill in your values.
# For Vercel, set these in Project Settings → Environment Variables.

# ─── Database ──────────────────────────────────────────────────────────────
# Production (Neon PostgreSQL). Get a free database at https://neon.tech.
# Local dev uses the same PostgreSQL provider — install Postgres locally or
# use a Docker container, then set DATABASE_URL accordingly.
DATABASE_URL=postgresql://user:password@localhost:5432/nixify?schema=public

# ─── Security ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-char-hex-string
OTP_PEPPER=replace-with-different-32-char-hex-string

# ─── Admin (Security Dashboard) ────────────────────────────────────────────
ADMIN_EMAIL=admin@nixify.dev
ADMIN_PASSWORD=change-this-strong-password

# ─── SMTP (Email Delivery) ─────────────────────────────────────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Nixify <nixify@yourdomain.com>
MAIL_REPLY_TO=support@yourdomain.com

# ─── App ───────────────────────────────────────────────────────────────────
APP_NAME=Nixify

# ─── Cron (Webhook Queue Processor) ───────────────────────────────────────
# Shared secret for POST /api/webhooks/process-queue. The cron caller must send
# this in either `Authorization: Bearer <CRON_SECRET>` or `x-cron-secret` header.
# Generate with: openssl rand -hex 32. REQUIRED in production (refused without).
CRON_SECRET=replace-with-32-char-hex-string

# ─── Optional: Redis (for rate limiting caching — not required) ────────────
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
