# Nixify — Environment Variables
# Copy this file to .env and fill in your values.
# For Vercel, set these in Project Settings → Environment Variables.

# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL is the only supported provider (prisma/schema.prisma is already
# provider = "postgresql"; there is no SQLite path).
#
# Production: Neon (PostgreSQL) — https://neon.tech.
#   - DATABASE_URL: Neon POOLED connection string (runtime queries).
#   - For `prisma migrate deploy` (DDL), use the Neon DIRECT (non-pooled)
#     connection string — Neon's transaction-mode pooling is incompatible with
#     migration DDL. See DEPLOY.md.
# Local dev: install Postgres locally or use a Docker container, then set
# DATABASE_URL accordingly.
DATABASE_URL=postgresql://user:password@localhost:5432/nixify?schema=public

# ─── Security ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-char-hex-string
OTP_PEPPER=replace-with-different-32-char-hex-string

# ─── Admin (Security Dashboard) ────────────────────────────────────────────
ADMIN_EMAIL=admin@nixify.dev
ADMIN_PASSWORD=change-this-strong-password

# ─── SMTP (Email Delivery) ─────────────────────────────────────────────────
# Shared SMTP configuration — the fallback for all email services (OTP,
# transactional, broadcast) that do not have a service-specific block.
# This is the ONLY configuration operators need to set today.
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Nixify <nixify@yourdomain.com>
MAIL_REPLY_TO=support@yourdomain.com

# Optional DKIM signing (applies to the shared configuration above).
# All three must be set together, or all must be absent.
# DKIM_DOMAIN=yourdomain.com
# DKIM_SELECTOR=nixify
# DKIM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ─── Optional: Service-specific SMTP configuration ─────────────────────────
# Each email service (OTP, transactional, broadcast) MAY have its own SMTP
# configuration block. If ANY variable in a service block is set, ALL core
# fields (HOST, PORT, USER, PASS, FROM) are required — partial blocks fail
# closed and do NOT fall back field-by-field to the shared config above.
#
# Operators do NOT need to configure these. The shared SMTP_* configuration
# above is sufficient. Service-specific blocks are for future phases where
# different workloads use different SMTP accounts.
#
# # OTP service-specific SMTP (overrides shared SMTP_* for OTP):
# OTP_SMTP_HOST=smtp.otp.example.com
# OTP_SMTP_PORT=465
# OTP_SMTP_USER=otp@example.com
# OTP_SMTP_PASS=otp-app-password
# OTP_SMTP_FROM=Nixify OTP <otp@example.com>
# OTP_MAIL_REPLY_TO=otp-support@example.com
# OTP_DKIM_DOMAIN=otp.example.com
# OTP_DKIM_SELECTOR=nixify-otp
# OTP_DKIM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#
# # Transactional service-specific SMTP:
# TRANSACTIONAL_SMTP_HOST=smtp.transactional.example.com
# TRANSACTIONAL_SMTP_PORT=465
# TRANSACTIONAL_SMTP_USER=Transactional@example.com
# TRANSACTIONAL_SMTP_PASS=transactional-app-password
# TRANSACTIONAL_SMTP_FROM=Nixify <noreply@example.com>
# TRANSACTIONAL_MAIL_REPLY_TO=support@example.com
# TRANSACTIONAL_DKIM_DOMAIN=example.com
# TRANSACTIONAL_DKIM_SELECTOR=nixify-transactional
# TRANSACTIONAL_DKIM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#
# # Broadcast service-specific SMTP:
# BROADCAST_SMTP_HOST=smtp.broadcast.example.com
# BROADCAST_SMTP_PORT=465
# BROADCAST_SMTP_USER=broadcast@example.com
# BROADCAST_SMTP_PASS=broadcast-app-password
# BROADCAST_SMTP_FROM=Nixify Updates <updates@example.com>
# BROADCAST_MAIL_REPLY_TO=updates@example.com
# BROADCAST_DKIM_DOMAIN=example.com
# BROADCAST_DKIM_SELECTOR=nixify-broadcast
# BROADCAST_DKIM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ─── App ───────────────────────────────────────────────────────────────────
APP_NAME=Nixify

# ─── Cron (Webhook Queue Processor) ───────────────────────────────────────
# Shared secret for POST /api/webhooks/process-queue. The cron caller must send
# this in either `Authorization: Bearer <CRON_SECRET>` or `x-cron-secret` header.
# Generate with: openssl rand -hex 32. REQUIRED in production (refused without).
CRON_SECRET=replace-with-32-char-hex-string

# ─── Optional: Redis (for rate limiting caching — not required) ────────────
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
